<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Module 3 – Clinic Partner (CCS) & Clinic Manager | Debtor Management Training</title>
<style>
  :root{--navy:#1B4F8C;--teal:#028090;--teall:#02A0B0;--gold:#E8A800;--red:#C0392B;--green:#1E8449;--orange:#CA6F1E;--dark:#1C2B3A;--grey:#6B7C8E;--lgrey:#D6E0EB;--offwh:#F4F6F9;--white:#ffffff;}
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'Segoe UI',Arial,sans-serif;background:var(--offwh);color:var(--dark);}
  .site-header{background:var(--navy);color:white;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.25);}
  .site-header-inner{display:flex;align-items:center;padding:12px 28px;border-left:6px solid var(--gold);}
  .site-header-inner h1{font-size:1rem;font-weight:700;letter-spacing:.03em;}
  .site-header-inner span{font-size:.8rem;color:#A8D4DF;margin-left:16px;}
  .badge{background:var(--gold);color:var(--dark);font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:3px;margin-left:auto;letter-spacing:.08em;}
  .progress-bar-wrap{height:5px;background:#1a3f6f;}
  .progress-bar{height:5px;background:var(--gold);transition:width .4s ease;}
  .nav-tabs{background:#162e52;display:flex;overflow-x:auto;padding:0 28px;gap:2px;}
  .nav-tab{background:none;border:none;color:#7fa8c9;font-size:.78rem;font-weight:600;padding:10px 14px;cursor:pointer;white-space:nowrap;border-bottom:3px solid transparent;transition:all .2s;}
  .nav-tab:hover{color:white;}
  .nav-tab.active{color:var(--gold);border-bottom-color:var(--gold);}
  .nav-tab.done{color:var(--teall);}
  main{max-width:1000px;margin:0 auto;padding:28px 20px 80px;}
  .section{display:none;animation:fadeIn .3s ease;}
  .section.active{display:block;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
  .section-header{background:var(--navy);color:white;padding:22px 28px;border-radius:8px 8px 0 0;border-left:7px solid var(--gold);}
  .section-header .step-num{font-size:.75rem;color:var(--gold);font-weight:700;letter-spacing:.1em;margin-bottom:4px;}
  .section-header h2{font-size:1.5rem;font-weight:700;}
  .section-body{background:white;border-radius:0 0 8px 8px;padding:28px;box-shadow:0 4px 16px rgba(0,0,0,.08);margin-bottom:20px;}
  .card-grid{display:grid;gap:16px;margin:18px 0;}
  .card-grid-2{grid-template-columns:1fr 1fr;}
  .card-grid-3{grid-template-columns:1fr 1fr 1fr;}
  @media(max-width:700px){.card-grid-2,.card-grid-3{grid-template-columns:1fr;}}
  .card{border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.09);}
  .card-header{padding:10px 14px;color:white;font-weight:700;font-size:.9rem;}
  .card-body{padding:14px;background:white;font-size:.88rem;line-height:1.6;}
  .checklist{list-style:none;margin:14px 0;}
  .checklist li{display:flex;align-items:flex-start;gap:10px;padding:9px 12px;border-radius:6px;margin-bottom:6px;font-size:.9rem;line-height:1.5;}
  .checklist li:nth-child(odd){background:var(--offwh);}
  .checklist .ci{width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;color:white;flex-shrink:0;margin-top:2px;}
  .alert{padding:14px 18px;border-radius:8px;margin:14px 0;font-size:.9rem;line-height:1.6;font-weight:600;display:flex;align-items:flex-start;gap:12px;}
  .alert-icon{font-size:1.3rem;flex-shrink:0;}
  .alert-red{background:#fdf2f0;border-left:5px solid var(--red);color:var(--red);}
  .alert-navy{background:#eef2f8;border-left:5px solid var(--navy);color:var(--navy);}
  .alert-green{background:#edf7ef;border-left:5px solid var(--green);color:var(--green);}
  .alert-gold{background:#fdf8e6;border-left:5px solid var(--gold);color:#7a5500;}
  .data-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:.86rem;}
  .data-table th{background:var(--navy);color:white;padding:10px 12px;text-align:left;}
  .data-table td{padding:9px 12px;border-bottom:1px solid var(--lgrey);vertical-align:top;}
  .data-table tr:nth-child(even) td{background:var(--offwh);}
  .quiz-wrap{margin:20px 0;}
  .quiz-q{background:white;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.09);margin-bottom:18px;overflow:hidden;}
  .quiz-q-hdr{background:var(--navy);color:white;padding:12px 18px;font-weight:700;font-size:.95rem;}
  .quiz-options{padding:14px 18px;display:flex;flex-direction:column;gap:8px;}
  .quiz-opt{background:var(--offwh);border:2px solid var(--lgrey);border-radius:6px;padding:10px 14px;cursor:pointer;font-size:.88rem;transition:all .2s;user-select:none;}
  .quiz-opt:hover{border-color:var(--teal);background:#e8f5f7;}
  .quiz-opt.correct{border-color:var(--green);background:#edf7ef;color:var(--green);font-weight:700;}
  .quiz-opt.wrong{border-color:var(--red);background:#fdf2f0;color:var(--red);}
  .quiz-feedback{padding:10px 18px 14px;font-size:.85rem;font-style:italic;color:var(--grey);display:none;}
  .quiz-feedback.show{display:block;}
  .bottom-nav{position:fixed;bottom:0;left:0;right:0;background:white;border-top:2px solid var(--lgrey);display:flex;align-items:center;justify-content:space-between;padding:12px 28px;z-index:99;box-shadow:0 -4px 16px rgba(0,0,0,.1);}
  .btn{padding:10px 24px;border-radius:6px;font-size:.88rem;font-weight:700;border:none;cursor:pointer;transition:all .2s;}
  .btn-primary{background:var(--navy);color:white;}
  .btn-primary:hover{background:#153d70;}
  .btn-secondary{background:var(--offwh);color:var(--navy);border:2px solid var(--lgrey);}
  .btn-secondary:hover{background:var(--lgrey);}
  .section-counter{font-size:.82rem;color:var(--grey);font-weight:600;}
  .completion-banner{background:var(--green);color:white;text-align:center;padding:30px;border-radius:10px;margin:20px 0;}
  .completion-banner h2{font-size:1.8rem;margin-bottom:8px;}
  .capture-panel{margin-top:22px;background:#eef2f8;border:2px solid var(--navy);border-radius:10px;padding:22px;}
  .capture-panel h3{color:var(--navy);margin-bottom:4px;font-size:1.1rem;}
  .capture-sub{font-size:.82rem;color:var(--grey);margin-bottom:14px;}
  .capture-row{display:flex;gap:12px;margin-bottom:12px;}
  .capture-field{flex:1;}
  .capture-field-full{margin-bottom:14px;}
  .capture-field label{font-size:.68rem;font-weight:700;color:var(--grey);text-transform:uppercase;display:block;margin-bottom:4px;}
  .capture-field input{width:100%;padding:9px 10px;border:1px solid var(--lgrey);border-radius:5px;font-size:.85rem;font-family:inherit;box-sizing:border-box;}
  .capture-panel .btn-mock-submit{background:var(--navy);color:#fff;border:none;padding:10px 22px;border-radius:6px;font-size:.85rem;font-weight:700;cursor:pointer;}
  .capture-panel .btn-mock-submit:hover{background:#153d70;}
  .capture-panel .btn-mock-submit:disabled{opacity:.6;cursor:default;}
  .capture-status{margin-left:12px;font-size:.82rem;font-weight:700;}
  .capture-saving{color:var(--grey);}
  .capture-success{color:var(--green);}
  .capture-error{color:var(--red);}
  .capture-done h3{color:var(--green);margin-bottom:4px;}
  .capture-done p{font-size:.82rem;color:var(--grey);}
  h3{color:var(--navy);font-size:1.05rem;margin:18px 0 10px;}
  p{font-size:.9rem;line-height:1.7;margin-bottom:10px;}
  .flow-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0;}
  .flow-node{background:var(--navy);color:white;border-radius:8px;padding:10px 16px;font-size:.85rem;font-weight:700;text-align:center;}
  .flow-arrow{font-size:1.4rem;color:var(--lgrey);font-weight:700;}
  .flow-node.highlight{background:var(--gold);color:var(--dark);}
  .threshold-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:14px 0;}
  @media(max-width:700px){.threshold-grid{grid-template-columns:1fr;}.flow-row{flex-direction:column;}}
  .threshold-card{border-radius:8px;overflow:hidden;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.09);}
  .threshold-hdr{padding:14px;color:white;font-weight:700;font-size:.9rem;}
  .threshold-body{background:white;padding:14px;font-size:.85rem;line-height:1.5;}
  .threshold-amount{font-size:1.3rem;font-weight:700;color:var(--navy);display:block;margin-bottom:6px;}
  .raci-table{width:100%;border-collapse:collapse;margin:14px 0;font-size:.82rem;}
  .raci-table th{background:var(--navy);color:white;padding:9px 10px;text-align:center;font-size:.8rem;}
  .raci-table th:first-child{text-align:left;}
  .raci-table td{padding:8px 10px;border-bottom:1px solid var(--lgrey);text-align:center;}
  .raci-table td:first-child{text-align:left;font-size:.83rem;font-weight:600;}
  .raci-table tr:nth-child(even) td{background:var(--offwh);}
  .rr{display:inline-block;width:26px;height:26px;border-radius:50%;font-size:.75rem;font-weight:700;line-height:26px;text-align:center;}
  .r-R{background:var(--red);color:white;}
  .r-A{background:var(--navy);color:white;}
  .r-C{background:var(--teal);color:white;}
  .r-I{background:var(--lgrey);color:var(--dark);}
  .r-dash{background:none;color:var(--lgrey);}
</style>
</head>
<body>
<header class="site-header">
  <div class="site-header-inner">
    <div>
      <h1>Healthia Allied Health Network — Debtor Management Training</h1>
      <span>Module 3: Clinic Partner (CCS) &amp; Clinic Manager</span>
    </div>
    <span class="badge">MODULE 3 OF 4</span><a href="../index.html" style="color:#A8D4DF;font-size:.75rem;font-weight:700;margin-left:14px;text-decoration:none;">← Training Hub</a>
  </div>
  <div class="progress-bar-wrap"><div class="progress-bar" id="progressBar" style="width:11%"></div></div>
</header>
<div class="nav-tabs" id="navTabs"></div>
<main>

  <!-- S0: Welcome -->
  <div class="section active" id="sec-0">
    <div class="section-header"><div class="step-num">INTRODUCTION</div><h2>Welcome — Module 3: Clinic Partner (CCS) &amp; Clinic Manager</h2></div>
    <div class="section-body">
      <p>This module is designed for <strong>Clinic Partners (CCS) and Clinic Managers</strong>. Your role is not day-to-day operational — it is <strong>governance, accountability, approval, and escalation</strong>. This module explains what that means in practice under the Final SOP.</p>
      <div class="alert alert-gold"><span class="alert-icon">🎯</span><div><strong>By the end of this module you will be able to:</strong><ul style="margin-top:8px;padding-left:18px;font-weight:400">
        <li>Understand your accountability for AR as a clinic-level KPI</li>
        <li>Apply the monitoring and review cadence for your clinic</li>
        <li>Execute the escalation pathway for high-risk and unrecoverable debt</li>
        <li>Apply the correct approval thresholds for Doubtful Debt Write-Offs</li>
        <li>Ensure delegation is in place when your Practice Manager is on leave</li>
      </ul></div></div>
      <div class="card-grid card-grid-2" style="margin-top:20px">
        <div class="card"><div class="card-header" style="background:var(--teal)">⏱ Duration</div><div class="card-body">Approx. 30–40 minutes</div></div>
        <div class="card"><div class="card-header" style="background:var(--navy)">👥 Audience</div><div class="card-body">Clinic Partners (CCS) and Clinic Managers</div></div>
        <div class="card"><div class="card-header" style="background:var(--gold);color:var(--dark)">📄 Reference</div><div class="card-body">AR & Debt Management Policy & Procedure (Final)</div></div>
        <div class="card"><div class="card-header" style="background:var(--green)">📋 Format</div><div class="card-body">Guided sections + leadership scenario quiz</div></div>
      </div>
    </div>
  </div>

  <!-- S1: Accountability -->
  <div class="section" id="sec-1">
    <div class="section-header"><div class="step-num">SECTION 1</div><h2>Your Accountability — It Starts Here</h2></div>
    <div class="section-body">
      <div class="alert alert-red"><span class="alert-icon">🛡️</span><div>Responsibility for invoicing, accounts receivable, and debt management sits at the clinic level — with the Practice Manager and <strong>with you</strong>. The SOP is explicit about this.</div></div>
      <div class="card-grid card-grid-2" style="margin-top:18px">
        <div class="card"><div class="card-header" style="background:var(--navy)">📊 It Is a KPI</div><div class="card-body">AR and debt management is a key performance indicator for your clinic. Results are reported to Regional Partners and leadership monthly. Poor performance is visible and tracked.</div></div>
        <div class="card"><div class="card-header" style="background:var(--red)">💸 Revenue Impact</div><div class="card-body">Write-offs and invoice adjustments from mismanaged debt directly reduce reported revenue. This impacts your clinic's P&L, EBITDA, and resulting dividends. The connection is direct.</div></div>
        <div class="card"><div class="card-header" style="background:var(--teal)">👥 Your Team Owns the Process</div><div class="card-body">You are accountable for ensuring your Practice Manager and admin team execute the SOP consistently. If the PM is on leave — you ensure delegation is formally arranged before they go.</div></div>
        <div class="card"><div class="card-header" style="background:var(--orange)">⬆️ Escalation Is Yours</div><div class="card-body">When unrecoverable debt is identified, escalation to the Regional Partner comes through you. You are also the first approval checkpoint in the Doubtful Debt Write-Off process.</div></div>
      </div>
    </div>
  </div>

  <!-- S2: Monitoring -->
  <div class="section" id="sec-2">
    <div class="section-header"><div class="step-num">SECTION 2</div><h2>Your Monitoring & Review Responsibilities</h2></div>
    <div class="section-body">
      <p>Your oversight is structured across three cadences. Each has defined actions and ownership at clinic level.</p>
      <div class="card-grid card-grid-3" style="margin-top:18px">
        <div class="card">
          <div class="card-header" style="background:var(--teal)">📅 Weekly</div>
          <div class="card-body">
            <ul style="padding-left:16px;font-size:.86rem;line-height:1.9">
              <li>Review Ageing Debts Report — all buckets</li>
              <li>Confirm PM and admin are executing follow-up actions</li>
              <li>Flag any 60+ or 90+ day movements</li>
              <li>Tier 3 clinics: participate in RP weekly check-in call</li>
            </ul>
          </div>
        </div>
        <div class="card">
          <div class="card-header" style="background:var(--navy)">📅 Monthly</div>
          <div class="card-body">
            <ul style="padding-left:16px;font-size:.86rem;line-height:1.9">
              <li>Review Doubtful Debtors XLSX prepared by PM</li>
              <li>Provide your approval before forwarding to Regional Partner</li>
              <li>Participate in RP monthly performance review</li>
              <li>Review write-offs approved in the period</li>
            </ul>
          </div>
        </div>
        <div class="card">
          <div class="card-header" style="background:var(--red)">⚡ Immediate</div>
          <div class="card-body">
            <ul style="padding-left:16px;font-size:.86rem;line-height:1.9">
              <li>Any unrecoverable debt identified → escalate to RP immediately</li>
              <li>90+ day debt increase → notify RP same day</li>
              <li>PM on leave without delegation → arrange before leave begins</li>
            </ul>
          </div>
        </div>
      </div>
      <div class="alert alert-gold"><span class="alert-icon">💡</span><div>Do not wait for the scheduled monthly review to escalate. Any 90+ day increase or unrecoverable debt identified must be escalated immediately — ad hoc escalation is an expected part of the process.</div></div>
    </div>
  </div>

  <!-- S3: Escalation & write-off -->
  <div class="section" id="sec-3">
    <div class="section-header"><div class="step-num">SECTION 3</div><h2>Escalation Pathway & Write-Off Approvals</h2></div>
    <div class="section-body">
      <h3>Escalation Flow</h3>
      <div class="flow-row">
        <div class="flow-node">Admin Team</div>
        <div class="flow-arrow">→</div>
        <div class="flow-node">Practice Manager</div>
        <div class="flow-arrow">→</div>
        <div class="flow-node highlight">Clinic Partner (CCS) / Clinic Manager</div>
        <div class="flow-arrow">→</div>
        <div class="flow-node">Regional Partner</div>
        <div class="flow-arrow">→</div>
        <div class="flow-node">GM / CFO</div>
      </div>

      <h3 style="margin-top:20px">Your Write-Off Approval Role</h3>
      <p>The Practice Manager prepares the Doubtful Debtors XLSX and submits it to you first. You review and approve — then forward to the Regional Partner. The approval thresholds then determine how far up it goes:</p>

      <div class="threshold-grid">
        <div class="threshold-card">
          <div class="threshold-hdr" style="background:var(--green)">Regional Partner</div>
          <div class="threshold-body"><span class="threshold-amount">Under $1,000</span>RP can approve after Clinic Partner sign-off</div>
        </div>
        <div class="threshold-card">
          <div class="threshold-hdr" style="background:var(--orange)">General Manager</div>
          <div class="threshold-body"><span class="threshold-amount">$1,000 – $4,999</span>GM approval required</div>
        </div>
        <div class="threshold-card">
          <div class="threshold-hdr" style="background:var(--red)">CFO</div>
          <div class="threshold-body"><span class="threshold-amount">$5,000+</span>CFO approval required</div>
        </div>
      </div>

      <div class="alert alert-red"><span class="alert-icon">⚠️</span><div><strong>Important:</strong> Approval must be obtained from all Partners before any write-off is processed in Nookal. Do not instruct the admin team to process a write-off until the correct approval is confirmed. Write-offs directly reduce P&L, EBITDA, and dividends.</div></div>

      <h3 style="margin-top:20px">Write-Off Criteria</h3>
      <ul class="checklist">
        <li><span class="ci" style="background:var(--navy)">•</span>Invoice overdue by 90–120+ days from unresponsive debtor despite repeated recovery efforts</li>
        <li><span class="ci" style="background:var(--navy)">•</span>Debt is unlikely to be recovered via a collection agency</li>
        <li><span class="ci" style="background:var(--navy)">•</span>Third Party Payer has determined the invoice does not meet claim requirements</li>
        <li><span class="ci" style="background:var(--navy)">•</span>The clinic must be profitable for write-offs to be approved</li>
      </ul>
    </div>
  </div>

  <!-- S4: RACI -->
  <div class="section" id="sec-4">
    <div class="section-header"><div class="step-num">SECTION 4</div><h2>RACI — Your Role at a Glance</h2></div>
    <div class="section-body">
      <p>The RACI matrix defines who is <strong>R</strong>esponsible, <strong>A</strong>ccountable, <strong>C</strong>onsulted, and <strong>I</strong>nformed for each activity. Your column is highlighted.</p>
      <div style="font-size:.82rem;margin-bottom:12px;display:flex;gap:12px;flex-wrap:wrap">
        <span><span class="rr r-R">R</span> Responsible</span>
        <span><span class="rr r-A">A</span> Accountable</span>
        <span><span class="rr r-C">C</span> Consulted</span>
        <span><span class="rr r-I">I</span> Informed</span>
      </div>
      <table class="raci-table">
        <thead><tr><th>Activity</th><th>Finance / Program Lead</th><th>GM / CFO</th><th>Regional Partner</th><th style="background:#2a5298;">Clinic Partner (CCS) / Clinic Manager</th><th>Practice Manager</th><th>Admin Team</th></tr></thead>
        <tbody id="raciBody"></tbody>
      </table>
    </div>
  </div>

  <!-- S5: Quiz -->
  <div class="section" id="sec-5">
    <div class="section-header"><div class="step-num">KNOWLEDGE CHECK</div><h2>Leadership Scenario Quiz</h2></div>
    <div class="section-body">
      <p>Governance and escalation scenarios. Select the best response for each situation.</p>
      <div id="quiz3"></div>
    </div>
  </div>

  <!-- S6: Complete -->
  <div class="section" id="sec-6">
    <div class="section-header"><div class="step-num">COMPLETE</div><h2>Module 3 Complete</h2></div>
    <div class="section-body">
      <div class="completion-banner">
        <h2>🎉 Well done!</h2>
        <p>You have completed Module 3 — Clinic Partner (CCS) &amp; Clinic Manager. You are now clear on your governance, approval, and escalation responsibilities.</p>
      </div>
      <h3>Your Key Commitments</h3>
      <ul class="checklist">
        <li><span class="ci" style="background:var(--teal)">✓</span>AR and debt management is your clinic-level KPI — it impacts P&L, EBITDA, and dividends</li>
        <li><span class="ci" style="background:var(--teal)">✓</span>Review weekly. Approve monthly. Escalate immediately when required.</li>
        <li><span class="ci" style="background:var(--teal)">✓</span>You are the first approval checkpoint in the Doubtful Debt Write-Off process</li>
        <li><span class="ci" style="background:var(--teal)">✓</span>Write-off thresholds: &lt;$1k = RP, $1k–$5k = GM, $5k+ = CFO</li>
        <li><span class="ci" style="background:var(--teal)">✓</span>Ensure formal delegation is arranged before your PM goes on leave</li>
        <li><span class="ci" style="background:var(--teal)">✓</span>Unrecoverable debt identified → escalate to Regional Partner immediately</li>
      </ul>
      <div class="capture-panel">
        <h3>✅ Record Your Completion</h3>
        <p class="capture-sub">Fill out this quick form to confirm you have finished this module.</p>
        <iframe width="100%" height="480" src="https://forms.office.com/Pages/ResponsePage.aspx?id=ciEaMhM51EC2WxHZ7Ft8xmBplmM5FKdPmdWssMampG9UM0UySjJZVUJHSFgzNTlNSVM3UTdEQkpDRC4u&embed=true" frameborder="0" marginwidth="0" marginheight="0" style="border:none;max-width:100%;max-height:100vh;border-radius:8px;" allowfullscreen webkitallowfullscreen mozallowfullscreen msallowfullscreen></iframe>
      </div>
    </div>
  </div>

</main>
<div class="bottom-nav">
  <button class="btn btn-secondary" id="btnPrev" onclick="navigate(-1)" disabled>← Previous</button>
  <span class="section-counter" id="sectionCounter">Section 1 of 7</span>
  <button class="btn btn-primary" id="btnNext" onclick="navigate(1)">Next →</button>
</div>
<script>
const sections=document.querySelectorAll('.section');
const tabs=document.getElementById('navTabs');
const progressBar=document.getElementById('progressBar');
const counter=document.getElementById('sectionCounter');
const btnPrev=document.getElementById('btnPrev');
const btnNext=document.getElementById('btnNext');
let current=0;
const total=sections.length;
const completed=new Set();
const tabLabels=['Welcome','Your Accountability','Monitoring Cadence','Escalation & Write-Off','RACI Matrix','Knowledge Check','Complete'];

tabLabels.forEach((label,i)=>{
  const btn=document.createElement('button');
  btn.className='nav-tab'+(i===0?' active':'');
  btn.textContent=label;
  btn.onclick=()=>goTo(i);
  tabs.appendChild(btn);
});
function goTo(idx){
  sections[current].classList.remove('active');
  tabs.querySelectorAll('.nav-tab')[current].classList.remove('active');
  if(current<idx)completed.add(current);
  tabs.querySelectorAll('.nav-tab')[current].className='nav-tab'+(completed.has(current)?' done':'');
  current=idx;
  sections[current].classList.add('active');
  tabs.querySelectorAll('.nav-tab')[current].className='nav-tab active';
  updateUI();window.scrollTo(0,0);
}
function navigate(dir){goTo(Math.max(0,Math.min(total-1,current+dir)));}
function updateUI(){
  btnPrev.disabled=current===0;
  btnNext.disabled=current===total-1;
  btnNext.textContent=current===total-1?'Complete ✓':'Next →';
  counter.textContent=`Section ${current+1} of ${total}`;
  progressBar.style.width=`${((current+1)/total)*100}%`;
}

const raciRows=[
  ['Daily bank reconciliation','-','-','-','-','R','A'],
  ['Ageing debts follow-up','-','-','-','C','R','A'],
  ['Approve Doubtful Debt Write-Off (first step)','I','I','C','A','R','-'],
  ['Escalation of 90+ day debt','C','I','R','A','C','-'],
  ['Doubtful Debt Write-Off <$1k','I','I','A','C','R','-'],
  ['Doubtful Debt Write-Off $1k–$5k','C','A','C','C','R','-'],
  ['Doubtful Debt Write-Off $5k+','R','A','I','I','R','-'],
  ['Monthly performance review','R','I','A','C','-','-'],
  ['Delegation during PM leave','-','-','I','A','R','-'],
];
const colorMap={'R':'r-R','A':'r-A','C':'r-C','I':'r-I','-':'r-dash'};
const raciBody=document.getElementById('raciBody');
raciRows.forEach((row)=>{
  const tr=document.createElement('tr');
  row.forEach((cell,ci)=>{
    const td=document.createElement('td');
    if(ci===0){td.textContent=cell;}
    else{const span=document.createElement('span');span.className='rr '+colorMap[cell];span.textContent=cell;td.appendChild(span);}
    if(ci===4){td.style.background='#f0f4ff';}
    tr.appendChild(td);
  });
  raciBody.appendChild(tr);
});

const quizData=[
  {q:"Your Practice Manager is going on two weeks' leave. No one has been delegated to manage AR in their absence. What must you do?",opts:["Let it lapse — the PM will catch up when they return","Arrange formal delegation before the PM leaves. Debt management does not pause for leave.","Ask another clinic's PM to keep an eye on it","Reduce reporting frequency for that fortnight"],correct:1,feedback:"Correct. Formal delegation must be arranged before leave begins. This is a defined requirement in the SOP. As Clinic Partner (CCS) or Clinic Manager, ensuring delegation is in place is your accountability — not the PM's."},
  {q:"The Practice Manager submits a Doubtful Debt Write-Off for $850. What is the correct approval process?",opts:["You approve it and process it in Nookal directly","You review and approve it, then forward to the Regional Partner who can approve under $1,000","You send it straight to the GM","You send it to the CFO"],correct:1,feedback:"Correct. For write-offs under $1,000, the Regional Partner can approve — but only after Clinic Partner (CCS)/Clinic Manager review and sign-off. You are the first checkpoint. Do not bypass your review step even for small amounts."},
  {q:"You review the weekly Ageing Debts Report and notice 90+ day debt has increased for the second consecutive week. What do you do?",opts:["Wait for the monthly performance review to address it","Note it and ask the PM to look into it when they have time","Notify the Regional Partner immediately and confirm what actions have been taken by the admin team","Write off the 90+ day debt immediately"],correct:2,feedback:"Correct. Any 90+ day increase must be escalated immediately — not held for the monthly review. You should also confirm with the PM what follow-up actions have been taken so you can give the RP a full picture."},
  {q:"A write-off submission comes to you for $5,200. Who must ultimately approve it?",opts:["You as Clinic Partner","Regional Partner","General Manager","CFO"],correct:3,feedback:"Correct. Under the Final SOP, any write-off of $5,000 or more requires CFO approval. Do not process the write-off in Nookal until CFO sign-off is confirmed in writing."},
];

const quizWrap=document.getElementById('quiz3');
let answered={};
quizData.forEach((q,qi)=>{
  const div=document.createElement('div');
  div.className='quiz-q';
  div.innerHTML=`<div class="quiz-q-hdr">Scenario Q${qi+1}: ${q.q}</div><div class="quiz-options">${q.opts.map((o,oi)=>`<div class="quiz-opt" data-qi="${qi}" data-oi="${oi}">${o}</div>`).join('')}</div><div class="quiz-feedback" id="fb3-${qi}">${q.feedback}</div>`;
  quizWrap.appendChild(div);
});
quizWrap.addEventListener('click',e=>{
  const opt=e.target.closest('.quiz-opt');
  if(!opt||answered[opt.dataset.qi]!==undefined)return;
  const qi=+opt.dataset.qi,oi=+opt.dataset.oi;
  answered[qi]=oi;
  quizWrap.querySelectorAll(`[data-qi="${qi}"]`).forEach(o=>{o.classList.add(+o.dataset.oi===quizData[qi].correct?'correct':'wrong');});
  document.getElementById(`fb3-${qi}`).classList.add('show');
});
updateUI();
</script>
<script src="../assets/knowledge-base.js"></script>
<script src="../assets/site-assistant.js"></script>
</body>
</html>
